DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/dms_dev"
JWT_SECRET="change_me"
ENCRYPTION_KEY="change_me_long_random_value"
PORT=4000
UPLOAD_DIR="./uploads"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# ============================================
# AI Configuration (Gemini / OpenAI)
# ============================================
# Enable AI features (true/false)
AI_ENABLED=true

# AI Provider: "gemini" (Google) or "openai" (OpenAI/Azure-compatible)
AI_PROVIDER=openai

# -------- Google Gemini --------
# Get your API key from: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Model options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.5-flash, gemini-3.6-flash
# GEMINI_MODEL=gemini-3.6-flash

# -------- OpenAI (or Azure/OpenAI-compatible) --------
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
# Model options: gpt-4o-mini (fast, cheap — RECOMMENDED), gpt-4o (better quality), gpt-3.5-turbo, o1, o3-mini
OPENAI_MODEL=gpt-4o-mini
# Optional: set for Azure OpenAI or compatible services (e.g. http://localhost:11434/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Creativity: 0.0 = deterministic, 1.0 = very creative
AI_TEMPERATURE=0.2

# Max tokens for AI responses
AI_MAX_OUTPUT_TOKENS=2048

# Default language for AI responses: en (English), ms (Bahasa Melayu)
AI_DEFAULT_LANGUAGE=en

# ============================================
# Integration Layer (ERP / WMS / PMS / Sales)
# ============================================
# No extra variables are required. The integration layer (/api/v1 REST,
# /api/integrations admin console, API keys, webhook endpoints, HMAC signing)
# reuses:
#   DATABASE_URL   -> ApiKey / WebhookEndpoint / IntegrationEvent / WebhookDelivery
#   ENCRYPTION_KEY -> encrypts API signing secrets and webhook secrets at rest
#
# IMPORTANT: keep ENCRYPTION_KEY stable. Changing it makes stored signing and
# webhook secrets undecryptable, so integrations fail with
# 401 SIGNATURE_INVALID until each key/endpoint secret is rotated.
#
# Verify after startup:
#   GET /api/v1/ping             (X-API-Key: dms_...)  -> machine auth
#   GET /api/integrations/catalog (Bearer <JWT admin>) -> admin catalog
