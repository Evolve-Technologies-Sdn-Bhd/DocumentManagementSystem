DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/dms_dev"
JWT_SECRET="change_me"
ENCRYPTION_KEY="change_me_long_random_value"
PORT=4000
UPLOAD_DIR="./uploads"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# ============================================
# AI / Google Gemini Configuration
# ============================================
# Enable AI features (true/false)
AI_ENABLED=true

# AI Provider (currently only "gemini" supported)
AI_PROVIDER=gemini

# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Model options: gemini-1.5-flash (fast, cheap — RECOMMENDED), gemini-1.5-pro (better quality), gemini-2.5-flash if available
GEMINI_MODEL=gemini-1.5-flash

# Creativity: 0.0 = deterministic, 1.0 = very creative
AI_TEMPERATURE=0.2

# Max tokens for AI responses
AI_MAX_OUTPUT_TOKENS=2048

# Default language for AI responses: en (English), ms (Bahasa Melayu)
AI_DEFAULT_LANGUAGE=en
