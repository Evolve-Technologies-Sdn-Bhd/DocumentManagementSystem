model DocumentVersion {
  id           Int      @id @default(autoincrement())
  documentId   Int
  version      String // e.g., "1.0", "1.1", "2.0"
  filePath     String
  fileName     String
  mimeType     String
  fileSize     Int // in bytes
  contentData  Json?    // Structured versioned content for non-FILE formats
  contentText  String?  @db.Text // Plain text extract of versioned content
  uploadedById Int
  isPublished  Boolean  @default(false)
  isEncrypted  Boolean  @default(false) // Whether file is AES-256 encrypted
  uploadedAt   DateTime @default(now())
  // Smart Document — ADDITIVE fields
  // Tracks the exact Smart Template Version snapshot used for this revision
  // Published revisions retain the template version even if the template is updated later
  smartTemplateVersionId Int?
  // When true: this revision is locked from direct edits (APPROVED/PUBLISHED/PENDING_APPROVAL states)
  smartContentIsLocked   Boolean  @default(false)
  // For final PDF generated at approval/publish time (document-quality PDF)
  smartFinalPdfPath      String?
  smartFinalPdfFileSize  Int?
  smartFinalPdfGeneratedAt DateTime?

  // Relations
  document          Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy        User                      @relation("VersionUploader", fields: [uploadedById], references: [id])
  epcRegistryRecord DocumentEpcRegistryRecord?
  expiryRenewalHistory DocumentExpiryRenewalHistory[]
  // Smart Document relations (additive)
  smartTemplateVersion SmartTemplateVersion? @relation(fields: [smartTemplateVersionId], references: [id], onDelete: SetNull)
  smartDocumentContent SmartDocumentContent?
  smartFieldChanges    SmartDocumentFieldChange[]

  @@index([documentId])
  @@index([version])
  @@index([smartTemplateVersionId])
}

model DocumentExpiryProfile {
  id                   Int           @id @default(autoincrement())
  documentId           Int           @unique
  trackingEnabled      Boolean       @default(true)
  startDate            DateTime?
  expiryDate           DateTime?
  expiryStatus         ExpiryStatus  @default(ACTIVE)
  renewalStatus        RenewalStatus @default(NOT_STARTED)
  expiringSoonDays     Int?
  reminder1Days        Int?
  reminder2Days        Int?
  reminder3Days        Int?
  reminder4Days        Int?
  lastReminder1SentAt  DateTime?
  lastReminder2SentAt  DateTime?
  lastReminder3SentAt  DateTime?
  lastReminder4SentAt  DateTime?
  remarks              String?       @db.Text
  companySnapshot      String?
  departmentSnapshot   String?
  folderSnapshotName   String?
  currentVersionSnapshot String?
  trackingDisabledAt   DateTime?
  trackingDisabledBy   Int?
  trackingDisabledReason String?     @db.Text
  createdBy            Int?
  updatedBy            Int?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  renewalHistory DocumentExpiryRenewalHistory[]
  watchers DocumentExpiryWatcher[]
  reminderRecipients DocumentExpiryReminderRecipient[]

  @@index([expiryStatus])
  @@index([renewalStatus])
  @@index([trackingEnabled])
  @@index([expiryDate])
}

model DocumentExpiryRenewalHistory {
  id                  Int           @id @default(autoincrement())
  documentId          Int
  expiryProfileId     Int
  documentVersionId   Int?
  fromVersion         String?
