  createdAt  DateTime       @default(now())

  // Relations
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([documentId])
  @@index([userId])
  @@index([createdAt])
}

enum ApprovalAction {
  SUBMITTED
  REVIEWED
  FIRST_APPROVED
  SECOND_APPROVED
  READY_FOR_PUBLISH
  PUBLISHED
  REJECTED
  ACKNOWLEDGED
  RETURNED
  SUPERSEDED
  OBSOLETED
  ARCHIVED

  // Legacy action (deprecated)
  APPROVED
}

