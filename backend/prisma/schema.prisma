// Prisma Schema for Document Management System (DMS)
// Database: MySQL

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id                  Int        @id @default(autoincrement())
  email               String     @unique
  password            String
  firstName           String?
  lastName            String?
  phone               String?
  department          String?
  position            String?
  employeeId          String?    @unique
  dateJoined          DateTime   @default(now())
  profileImage        String?
  status              UserStatus @default(ACTIVE)
  lastLogin           DateTime?
  failedAttempts      Int        @default(0)
  lockedUntil         DateTime?
  // Two-Factor Authentication
  twoFactorEnabled    Boolean    @default(false)
  twoFactorMethod     String?    @default("email")
  twoFactorSecret     String?
  twoFactorTempSecret String?
  twoFactorCode       String?
  twoFactorCodeExpiry DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Relations
  roles                     UserRole[]
  sessions                  UserSession[]
  trustedDevices            TrustedDevice[]
  passwordResetCode         PasswordResetCode?
  preferences               UserPreference?
  createdDocuments          Document[]                 @relation("DocumentCreator")
  ownedDocuments            Document[]                 @relation("DocumentOwner")
  reviewingDocuments        Document[]                 @relation("DocumentReviewer")
  firstApprovingDocuments   Document[]                 @relation("DocumentFirstApprover")
  secondApprovingDocuments  Document[]                 @relation("DocumentSecondApprover")
  createdFolders            Folder[]                   @relation("FolderCreator")
  approvalHistory           ApprovalHistory[]
  comments                  DocumentComment[]
  notifications             Notification[]
  auditLogs                 AuditLog[]
  versionUploads            DocumentVersion[]          @relation("VersionUploader")
  generatedReports          GeneratedReport[]
  backups                   Backup[]
  createdSupersedeRequests  SupersedeObsoleteRequest[] @relation("RequestCreator")
  reviewedSupersedeRequests SupersedeObsoleteRequest[] @relation("RequestReviewer")
  approvedSupersedeRequests SupersedeObsoleteRequest[] @relation("RequestApprover")
  rejectedSupersedeRequests SupersedeObsoleteRequest[] @relation("RequestRejector")
  createdVersionRequests    VersionRequest[]           @relation("VersionRequestCreator")
  reviewedVersionRequests   VersionRequest[]           @relation("VersionRequestReviewer")
  approvedVersionRequests   VersionRequest[]           @relation("VersionRequestApprover")
  rejectedVersionRequests   VersionRequest[]           @relation("VersionRequestRejector")
  documentAssignments       DocumentAssignment[]
  createdTemplateRequests   TemplateRequest[]          @relation("TemplateRequestCreator")
  resolvedTemplateRequests  TemplateRequest[]          @relation("TemplateRequestResolver")
  folderPermissions         FolderPermission[]
  managedProjects           Project[]                  @relation("ProjectManager")
  createdProjects           Project[]                  @relation("ProjectCreator")
  assignedProjectItems      ProjectIterationDocumentItem[] @relation("ProjectItemAssignee")
  linkedProjectDocuments    ProjectDocumentLink[]      @relation("ProjectDocumentLinkedBy")
  epcTrackingUpdates        DocumentEpcRegistryRecord[] @relation("EpcTrackingUpdatedBy")
  documentConfidentialAccessEntries DocumentConfidentialAccess[]
  requirementConfidentialAccessEntries ProjectCategoryDocumentRequirementConfidentialAccess[]
  projectSetupRequirementDefaultAccessEntries ProjectSetupDocumentRequirementDefaultConfidentialAccess[]
  projectSetupRequirementOverrideAccessEntries ProjectSetupDocumentRequirementOverrideConfidentialAccess[]
  createdProjectChangeRequests ProjectChangeRequest[] @relation("ProjectChangeRequestCreator")
  expiryWatchers            DocumentExpiryWatcher[]
  expiryReminderRecipients  DocumentExpiryReminderRecipient[]
  createdDocumentShareLinks DocumentShareLink[] @relation("DocumentShareLinkCreator")
  divisions                  UserDivision[]
  projectRequiredDocumentPicAssignments ProjectRequiredDocumentPicAssignment[] @relation("ProjectRequiredDocumentPicUser")
  projectRequiredDocumentPicAssignedActions ProjectRequiredDocumentPicAssignment[] @relation("ProjectRequiredDocumentPicAssignedBy")
  crmTenderEntriesCreated    CrmTenderEntry[]   @relation("CrmTenderCreatedBy")
  crmFbEnquiryEntriesCreated CrmFbEnquiryEntry[] @relation("CrmFbEnquiryCreatedBy")
  crmFbEnquiryAssigneeEntries CrmFbEnquiryAssignee[] @relation("CrmFbEnquiryAssigneeUser")
  crmFbEnquiryAssigneeEntriesCreated CrmFbEnquiryAssignee[] @relation("CrmFbEnquiryAssigneeCreatedBy")
  crmFbEnquiryFollowUpLogsAssigned CrmFbEnquiryFollowUpLog[] @relation("CrmFbEnquiryFollowUpAssignedTo")
  crmFbEnquiryFollowUpLogsCreated CrmFbEnquiryFollowUpLog[] @relation("CrmFbEnquiryFollowUpCreatedBy")
  crmTenderAssigneeEntries CrmTenderAssignee[] @relation("CrmTenderAssigneeUser")
  crmTenderAssigneeEntriesCreated CrmTenderAssignee[] @relation("CrmTenderAssigneeCreatedBy")
  crmTenderFollowUpLogsAssigned CrmTenderFollowUpLog[] @relation("CrmTenderFollowUpAssignedTo")
  crmTenderFollowUpLogsCreated CrmTenderFollowUpLog[] @relation("CrmTenderFollowUpCreatedBy")
  // Smart Document — additive relations
  createdSmartDocumentStyleProfiles SmartDocumentStyleProfile[]
  createdSmartTemplates SmartTemplate[] @relation("SmartTemplateCreator")
  createdSmartTemplateVersions SmartTemplateVersion[] @relation("SmartTemplateVersionCreator")
  publishedSmartTemplateVersions SmartTemplateVersion[] @relation("SmartTemplateVersionPublisher")
  createdSmartDocumentContents SmartDocumentContent[] @relation("SmartDocContentCreator")
  changedSmartDocumentFields SmartDocumentFieldChange[] @relation("SmartDocFieldChangedBy")

  @@index([email])
  @@index([employeeId])
}

model PasswordResetCode {
  id         Int       @id @default(autoincrement())
  userId     Int       @unique
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  lastSentAt DateTime  @default(now())
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([consumedAt])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum TemplateRequestType {
  NEW
  UPDATE
}

enum TemplateRequestStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum RfidTrackingStatus {
  REGISTER
  CHECK_IN
  CHECK_OUT
  ARCHIVE
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  displayName String
  description String?
  permissions Json? // Store permissions as JSON
  isSystem    Boolean  @default(false) // System roles cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users             UserRole[]
  workflowSteps     WorkflowStep[]
  folderPermissions FolderPermission[]
  documentConfidentialAccessEntries DocumentConfidentialAccess[]
  requirementConfidentialAccessEntries ProjectCategoryDocumentRequirementConfidentialAccess[]
  projectSetupRequirementDefaultAccessEntries ProjectSetupDocumentRequirementDefaultConfidentialAccess[]
  projectSetupRequirementOverrideAccessEntries ProjectSetupDocumentRequirementOverrideConfidentialAccess[]
}

model UserRole {
  id         Int      @id @default(autoincrement())
  userId     Int
  roleId     Int
  assignedAt DateTime @default(now())
  assignedBy Int?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model UserSession {
  id           Int      @id @default(autoincrement())
  userId       Int
  token        String   @unique @db.VarChar(512)
  refreshToken String?  @unique @db.VarChar(512)
  device       String?
  ipAddress    String?
  userAgent    String?  @db.Text
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TrustedDevice {
  id         Int       @id @default(autoincrement())
  userId     Int
  tokenHash  String    @unique @db.VarChar(128)
  userAgent  String?   @db.Text
  ipAddress  String?
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model UserPreference {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  language      String   @default("en")
  timezone      String   @default("Asia/Kuala_Lumpur")
  dateFormat    String   @default("DD/MM/YYYY")
  timeFormat    String   @default("24h")
  itemsPerPage  Int      @default(15)
  defaultView   String   @default("list")
  emailDigest   String   @default("daily")
  notifications Json? // Email and in-app notification preferences
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// DOCUMENT MANAGEMENT
// ============================================

model DocumentType {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  prefix      String   @unique // e.g., "DOC", "MoM", "PP"
  description String?
  isActive    Boolean  @default(true)
  requiresExpiryTracking Boolean @default(false)
  allowRenewal Boolean @default(true)
  // Smart Document — ADDITIVE fields
  creationMode CreationMode @default(FILE_BASED) // FILE_BASED or SMART_DOCUMENT
  // Points to DEFAULT SmartTemplate. DocumentType can have only 1 default active template.
  smartTemplateId Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  documents        Document[]
  templates        Template[]
  templateRequests TemplateRequest[]
  workflows        Workflow[]
  codeRegistries   CodeRegistry[]
  projectRequirements ProjectCategoryDocumentRequirement[]
  projectItems        ProjectIterationDocumentItem[]
  projectSetupDefaultRequirements ProjectSetupDocumentRequirementDefault[]
  projectSetupOverrideRequirements ProjectSetupDocumentRequirementOverride[]
  projectRequiredDocumentPicAssignments ProjectRequiredDocumentPicAssignment[]
  // Smart Document relation — one DocumentType can have many SmartTemplates configured over time
  smartTemplates        SmartTemplate[] @relation("DocTypeSmartTemplates")
  smartDefaultTemplate SmartTemplate?  @relation("DocTypeDefaultSmartTemplate", fields: [smartTemplateId], references: [id], onDelete: SetNull)
}

model ProjectCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String   @unique // e.g., "INT", "EXT", "CLIENT"
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  documents      Document[]
  codeRegistries CodeRegistry[]
  projects             Project[]
  categoryStages       ProjectCategoryStage[]
  documentRequirements ProjectCategoryDocumentRequirement[]
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String   @unique // e.g., "IT", "HR", "FIN"
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Division {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   UserDivision[]
  folders FolderDivision[]
  documents Document[]
  projects Project[]
}

model UserDivision {
  id         Int      @id @default(autoincrement())
  userId     Int
  divisionId Int
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@unique([userId, divisionId])
  @@index([userId])
  @@index([divisionId])
}

model Folder {
  id                 Int      @id @default(autoincrement())
  name               String
  parentId           Int?
  createdById        Int
  accessMode         String   @default("PUBLIC")
  inheritPermissions Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  parent      Folder?            @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Folder[]           @relation("FolderHierarchy")
  documents   Document[]
  createdBy   User               @relation("FolderCreator", fields: [createdById], references: [id])
  permissions FolderPermission[]
  divisions   FolderDivision[]

  @@index([parentId])
  @@index([createdById])
}

model FolderDivision {
  id         Int      @id @default(autoincrement())
  folderId   Int
  divisionId Int
  createdAt  DateTime @default(now())

  folder   Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@unique([folderId, divisionId])
  @@index([folderId])
  @@index([divisionId])
}

model FolderPermission {
  id          Int      @id @default(autoincrement())
  folderId    Int
  userId      Int?
  roleId      Int?
  canView     Boolean  @default(false)
  canCreate   Boolean  @default(false)
  canEdit     Boolean  @default(false)
  canDelete   Boolean  @default(false)
  canDownload Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role?  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([folderId, userId])
  @@unique([folderId, roleId])
  @@index([folderId])
  @@index([userId])
  @@index([roleId])
}

model Document {
  id                Int           @id @default(autoincrement())
  fileCode          String        // e.g., DOC-2025-001
  isClientDocument  Boolean       @default(false)
  isConfidential    Boolean       @default(false)
  contentFormat     ContentFormat @default(FILE)
  contentData       Json?         // Structured content for RICH_TEXT, CHECKLIST, FORM, LINK, TABLE
  contentText       String?       @db.Text // Plain text extract for search/previews
  title             String
  description       String?       @db.Text
  documentTypeId    Int
  projectCategoryId Int?
  divisionId        Int?
  folderId          Int? // Folder assignment
  status            DocStatus     @default(DRAFT)
  stage             WorkflowStage @default(DRAFT)
  version           String        @default("1.0")
  creationMode      CreationMode  @default(FILE_BASED) // FILE_BASED or SMART_DOCUMENT

  // User references
  createdById      Int
  ownerId          Int // Current document owner
  submittedById    Int?
  reviewerId       Int? // Assigned reviewer
  reviewedById     Int? // User who completed the review
  firstApproverId  Int? // First level approver
  secondApproverId Int? // Second level approver
  publishedById    Int? // User who published the document
  acknowledgedById Int?

  // Supersede/Obsolete
  supersededById Int? // Document that supersedes this one
  obsoleteReason String?   @db.Text
  obsoleteDate   DateTime?

  // Document date (for file code generation)
  dateOfDocument DateTime? // User-specified document date (used in file code)

  // Timestamps
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  submittedAt      DateTime?
  reviewedAt       DateTime?
  firstApprovedAt  DateTime?
  secondApprovedAt DateTime?
  acknowledgedAt   DateTime?
  publishedAt      DateTime?

  // Relations
  documentType           DocumentType               @relation(fields: [documentTypeId], references: [id])
  projectCategory        ProjectCategory?           @relation(fields: [projectCategoryId], references: [id], onDelete: SetNull)
  division               Division?                  @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  folder                 Folder?                    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdBy              User                       @relation("DocumentCreator", fields: [createdById], references: [id])
  owner                  User                       @relation("DocumentOwner", fields: [ownerId], references: [id])
  reviewer               User?                      @relation("DocumentReviewer", fields: [reviewerId], references: [id])
  firstApprover          User?                      @relation("DocumentFirstApprover", fields: [firstApproverId], references: [id])
  secondApprover         User?                      @relation("DocumentSecondApprover", fields: [secondApproverId], references: [id])
  versions               DocumentVersion[]
  approvalHistory        ApprovalHistory[]
  comments               DocumentComment[]
  metadata               DocumentMetadata[]
  supersededBy           Document?                  @relation("DocumentSupersede", fields: [supersededById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  supersedes             Document[]                 @relation("DocumentSupersede")
  supersedeRequests      SupersedeObsoleteRequest[] @relation("DocumentToObsolete")
  supersedingForRequests SupersedeObsoleteRequest[] @relation("SupersedingDocument")
  versionRequests        VersionRequest[]           @relation("VersionRequestSource")
  newVersionRequests     VersionRequest[]           @relation("VersionRequestNew")
  assignments            DocumentAssignment[]
  epcRegistryRecords     DocumentEpcRegistryRecord[]
  projectLinks           ProjectDocumentLink[]
  confidentialAccess     DocumentConfidentialAccess[]
  shareLinks             DocumentShareLink[]
  expiryProfile          DocumentExpiryProfile?
  expiryRenewalHistory   DocumentExpiryRenewalHistory[]
  // Smart Document — additive relations
  smartDocumentContents  SmartDocumentContent[]
  smartDocumentFieldChanges SmartDocumentFieldChange[]
  // Per-document style profile override (null = inherit from template)
  smartDocumentStyleProfileId Int?
  smartDocumentStyleProfile   SmartDocumentStyleProfile? @relation("DocStyleProfile", fields: [smartDocumentStyleProfileId], references: [id], onDelete: SetNull)

  @@unique([fileCode, projectCategoryId])
  @@index([fileCode])
  @@index([status])
  @@index([stage])
  @@index([documentTypeId])
  @@index([projectCategoryId])
  @@index([divisionId])
  @@index([folderId])
  @@index([createdById])
  @@index([ownerId])
  @@index([createdAt])
}

enum ContentFormat {
  FILE
  RICH_TEXT
  CHECKLIST
  FORM
  LINK
  TABLE
}

enum AccessSubjectType {
  USER
  ROLE
}

model DocumentConfidentialAccess {
  id          Int               @id @default(autoincrement())
  documentId  Int
  subjectType AccessSubjectType
  userId      Int?
  roleId      Int?
  canView     Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role?    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@unique([documentId, roleId])
  @@index([documentId])
  @@index([userId])
  @@index([roleId])
  @@index([subjectType])
}

model DocumentShareLink {
  id             Int      @id @default(autoincrement())
  documentId     Int
  createdById    Int
  tokenHash      String   @unique @db.VarChar(128)
  expiresAt      DateTime
  revokedAt      DateTime?
  lastAccessedAt DateTime?
  accessCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User     @relation("DocumentShareLinkCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@index([createdById])
  @@index([expiresAt])
  @@index([revokedAt])
}

enum DocStatus {
  DRAFT
  PENDING_REVIEW
  IN_REVIEW
  PENDING_FIRST_APPROVAL
  IN_FIRST_APPROVAL
  PENDING_SECOND_APPROVAL
  IN_SECOND_APPROVAL
  READY_TO_PUBLISH
  PENDING_ACKNOWLEDGMENT
  ACKNOWLEDGED
  APPROVED
  PUBLISHED
  REJECTED
  RETURNED
  SUPERSEDED
  OBSOLETE
  ARCHIVED

  // Legacy statuses (deprecated but kept for backward compatibility)
  PENDING_APPROVAL
  IN_APPROVAL
}

enum WorkflowStage {
  DRAFT
  REVIEW
  FIRST_APPROVAL
  SECOND_APPROVAL
  READY_TO_PUBLISH
  ACKNOWLEDGMENT
  PUBLISHED
  SUPERSEDED
  OBSOLETE

  // Legacy stage (deprecated but kept for backward compatibility)
  APPROVAL
}

enum ExpiryStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRING_TODAY
  EXPIRED
}

enum RenewalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum ExpiryReminderLevel {
  REMINDER_1
  REMINDER_2
  REMINDER_3
  REMINDER_4
}

model Project {
  id                Int           @id @default(autoincrement())
  code              String        @unique
  name              String
  description       String?       @db.Text
  divisionId        Int?
  clientName        String?
  clientPic         String?
  teamMembers       String?       @db.Text
  startDate         DateTime?
  plannedCompletionDate DateTime?
  actualCompletionDate  DateTime?
  scope             String?       @db.Text
  objective         String?       @db.Text
  deliverables      String?       @db.Text
  projectCategoryId Int
  managerId         Int
  createdById       Int
  status            ProjectStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  division        Division?        @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  projectCategory ProjectCategory  @relation(fields: [projectCategoryId], references: [id], onDelete: Restrict)
  manager         User             @relation("ProjectManager", fields: [managerId], references: [id], onDelete: Restrict)
  createdBy       User             @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  iterations      ProjectIteration[]
  setupStageOverrides ProjectSetupStageOverride[]
  setupRequirementOverrides ProjectSetupDocumentRequirementOverride[]
  changeRequests  ProjectChangeRequest[]
  requiredDocumentPicAssignments ProjectRequiredDocumentPicAssignment[]

  @@index([divisionId])
  @@index([projectCategoryId])
  @@index([managerId])
  @@index([createdById])
  @@index([status])
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  CLOSED
  ARCHIVED
}

model ProjectIteration {
  id             Int      @id @default(autoincrement())
  projectId      Int
  iterationNo    Int
  name           String?
  currentStageId Int?
  startedAt      DateTime?
  endedAt        DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project                 Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  currentStage            ProjectStageDefinition? @relation("IterationCurrentStage", fields: [currentStageId], references: [id], onDelete: SetNull)
  items                   ProjectIterationDocumentItem[]
  links                   ProjectDocumentLink[]
  changeRequests          ProjectChangeRequest[]

  @@unique([projectId, iterationNo])
  @@index([projectId])
  @@index([currentStageId])
  @@index([isActive])
}

model ProjectChangeRequest {
  id                 Int      @id @default(autoincrement())
  projectId          Int
  projectIterationId Int?
  changeId           String
  phaseRef           String?
  description        String   @db.Text
  impact             String?  @db.Text
  authorizedBy       String?
  complianceSignOff  String?
  dateApproved       DateTime?
  createdById        Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  iteration ProjectIteration? @relation(fields: [projectIterationId], references: [id], onDelete: SetNull)
  createdBy User             @relation("ProjectChangeRequestCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([projectId, changeId])
  @@index([projectId])
  @@index([projectIterationId])
  @@index([createdById])
  @@index([createdAt])
}

model ProjectStageDefinition {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  name      String
  sortOrder Int
  isSystem  Boolean  @default(true)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryStages      ProjectCategoryStage[]
  currentForIterations ProjectIteration[] @relation("IterationCurrentStage")
  requirements        ProjectCategoryDocumentRequirement[]
  setupStageDefaults  ProjectSetupStageDefault[]
  setupStageOverrides ProjectSetupStageOverride[]
  setupDefaultRequirements ProjectSetupDocumentRequirementDefault[]
  setupOverrideRequirements ProjectSetupDocumentRequirementOverride[]
  items               ProjectIterationDocumentItem[]
  links               ProjectDocumentLink[]
  requiredDocumentPicAssignments ProjectRequiredDocumentPicAssignment[]

  @@index([sortOrder])
  @@index([isActive])
}

model ProjectCategoryStage {
  id                Int      @id @default(autoincrement())
  projectCategoryId Int
  stageId           Int
  displayName       String?
  sortOrder         Int?
  isEnabled         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  projectCategory ProjectCategory        @relation(fields: [projectCategoryId], references: [id], onDelete: Cascade)
  stage           ProjectStageDefinition @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([projectCategoryId, stageId])
  @@index([projectCategoryId])
  @@index([stageId])
  @@index([isEnabled])
}

model ProjectCategoryDocumentRequirement {
  id                    Int      @id @default(autoincrement())
  projectCategoryId     Int
  stageId               Int
  documentTypeId        Int
  isRequired            Boolean  @default(true)
  isConfidentialDefault Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  projectCategory ProjectCategory        @relation(fields: [projectCategoryId], references: [id], onDelete: Cascade)
  stage           ProjectStageDefinition @relation(fields: [stageId], references: [id], onDelete: Cascade)
  documentType    DocumentType           @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  confidentialAccess ProjectCategoryDocumentRequirementConfidentialAccess[]

  @@unique([projectCategoryId, stageId, documentTypeId], map: "PCDR_pcid_sid_dtid_key")
  @@index([projectCategoryId])
  @@index([stageId])
  @@index([documentTypeId])
  @@index([isRequired])
}

model ProjectCategoryDocumentRequirementConfidentialAccess {
  id            Int               @id @default(autoincrement())
  requirementId Int
  subjectType   AccessSubjectType
  userId        Int?
