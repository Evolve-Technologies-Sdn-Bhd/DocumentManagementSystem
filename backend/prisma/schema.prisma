// ============================================
// REPORTS & ANALYTICS
// ============================================

model GeneratedReport {
  id            Int          @id @default(autoincrement())
  reportType    String // e.g., 'document-stats', 'user-activity'
  reportName    String
  filePath      String?
  format        String // PDF, EXCEL, CSV
  fileSize      Int? // in bytes
  status        ReportStatus @default(PENDING)
  config        Json? // Report configuration (date range, filters, etc)
  generatedById Int?
  createdAt     DateTime     @default(now())
  completedAt   DateTime?

  // Relations
  generatedBy User? @relation(fields: [generatedById], references: [id], onDelete: SetNull)

  @@index([generatedById])
  @@index([reportType])
  @@index([status])
  @@index([createdAt])
}

enum ReportStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

// ============================================
// SYSTEM CONFIGURATION
// ============================================

model Configuration {
  id          Int      @id @default(autoincrement())
  key         String   @unique
