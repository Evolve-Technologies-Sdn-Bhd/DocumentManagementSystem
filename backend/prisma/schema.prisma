// ============================================
// SMART DOCUMENT (ADDITIVE - Phase 1)
// ============================================

enum CreationMode {
  FILE_BASED
  SMART_DOCUMENT
}

enum SmartFieldInputType {
  TEXT
  TEXTAREA
  RICH_TEXT
  NUMBER
  DATE
  DATETIME
  DROPDOWN
  SINGLE_SELECT
  MULTI_SELECT
  CHECKBOX
  USER_LOOKUP
  TABLE
  IMAGE
  ATTACHMENT
  REPEATER
  SYSTEM_GENERATED
}

enum SmartPlaceholderType {
  SIMPLE_VALUE
  RICH_TEXT_CONTENT
  TABLE_ROWS
  IMAGE
  REPEATED_SECTION
  HEADER_FIELD
  FOOTER_FIELD
}

enum SmartPageOrientation {
  PORTRAIT
  LANDSCAPE
}

enum SmartPageSize {
  A4
  LETTER
  LEGAL
  CUSTOM
}

model SmartDocumentStyleProfile {
  id               Int      @id @default(autoincrement())
  profileName      String   @unique
  description      String?  @db.Text
  isActive         Boolean  @default(true)
  isDefault        Boolean  @default(false)

  // Page settings
  pageSize         SmartPageSize   @default(A4)
  pageOrientation  SmartPageOrientation @default(PORTRAIT)
  pageWidthMm      Decimal?  @db.Decimal(10, 2)
  pageHeightMm     Decimal?  @db.Decimal(10, 2)
  marginTopMm      Decimal   @db.Decimal(10, 2) @default(25.4)
  marginBottomMm   Decimal   @db.Decimal(10, 2) @default(25.4)
  marginLeftMm     Decimal   @db.Decimal(10, 2) @default(25.4)
  marginRightMm    Decimal   @db.Decimal(10, 2) @default(25.4)

  // Font defaults (kept as fallbacks — full structured overrides in typographyJson below)
  bodyFontFamily   String   @default("Arial")
  bodyFontSizePt   Int      @default(11)
  heading1FontSizePt Int    @default(16)
  heading2FontSizePt Int    @default(14)
  heading3FontSizePt Int    @default(12)
  heading4FontSizePt Int    @default(11)
  headingFontFamily String  @default("Arial")
  headingFontBold  Boolean  @default(true)
  tableFontFamily  String   @default("Arial")
  tableFontSizePt  Int      @default(10)

  // ===== Full Professional Typography Overrides =====
  // Per-category: heading1-4, body, tableHeader, tableCell, listItem, headerText, footerText, caption
  // Keys: fontFamily, fontSizePt, bold, italic, underline, color, spacingBeforePt, spacingAfterPt, lineSpacingMultiplier, indentMm, bulletStyle, fillColor, verticalAlign, position
  typographyJson   Json?

  // Spacing
  lineSpacing      Decimal  @db.Decimal(4, 2) @default(1.15)
  paragraphSpacingBeforePt Int @default(0)
  paragraphSpacingAfterPt  Int @default(6)

  // Header configuration
  headerEnabled    Boolean  @default(true)
  headerHeightMm   Decimal? @db.Decimal(10, 2)
  headerLogoPath   String?
  // ===== Professional Evolve-style Header (logo + name/regno + address + tel + email + line) =====
  headerUseProfessionalLayout Boolean  @default(true)
  // Logo size in millimetres (aspect ratio preserved if only one set)
  logoWidthMm      Decimal? @db.Decimal(10, 2)
  logoHeightMm     Decimal? @db.Decimal(10, 2)
  // Company Identity line (bold + underline + reg number)
  headerCompanyName   String?
  headerCompanyRegNo  String?
  headerCompanyNameUnderline Boolean @default(true)
  headerCompanyNameColor  String?  @default("#1F2937")
  // Multi-line address (stored as JSON array of strings, one line per element)
  headerCompanyAddressJson Json?
  // Contact lines
  headerCompanyPhone String?
  headerCompanyEmail String?
  headerCompanyEmailColor String? @default("#0563C1") // Microsoft Word hyperlink blue
  // Divider line under full header (Evolve format = thick black line across full width)
  headerBottomDividerEnabled    Boolean  @default(true)
  headerBottomDividerWidthPt    Decimal  @db.Decimal(4, 2) @default(1.5)
  headerBottomDividerColor      String?  @default("#000000")
  // Legacy simple layout fallbacks if headerUseProfessionalLayout = false
  headerLeftText   String?  @db.Text
  headerCenterText String?  @db.Text
  headerRightText  String?  @db.Text
  headerBorderBottomStyle String? @default("single")

  // Footer configuration
  footerEnabled    Boolean  @default(true)
  footerHeightMm   Decimal? @db.Decimal(10, 2)
  // ===== Professional Footer Standards (pro-controlled documentation) =====
  footerUseProfessionalLayout Boolean  @default(true)
  // Confidentiality / classification line (e.g. "CONFIDENTIAL - Property of Evolve Technology Platform Sdn. Bhd.")
  footerConfidentialText   String?
  footerClassificationMark String? // e.g. "INTERNAL / SOP / RESTRICTED"
  // Auto-doc metadata display toggles
  footerShowDocCodeAndRev Boolean @default(true)
  footerShowEffectiveDate Boolean @default(true)
  footerShowPreparedBy    Boolean @default(true)
  footerShowApprovedBy    Boolean @default(false)
  footerDisclaimerText    String? // Copyright or legal disclaimer line
  // Top divider above footer
  footerTopDividerEnabled  Boolean  @default(true)
  footerTopDividerWidthPt  Decimal  @db.Decimal(4, 2) @default(0.75)
  footerTopDividerColor    String?  @default("#6B7280")
  // Legacy simple layout fallbacks
  footerLeftText   String?  @db.Text
  footerCenterText String?  @db.Text
  footerRightText  String?  @db.Text
  showPageNumbers  Boolean  @default(true)
  pageNumberFormat String?  @default("Page X of Y")
  showDocumentInfo Boolean  @default(true)
  footerBorderTopStyle String? @default("single")

  // Table formatting
  tableBorderStyle  String  @default("single")
  tableBorderWidthPt Decimal @db.Decimal(4, 2) @default(0.5)
  tableHeaderFillColor String? @default("#F2F2F2")
  tableHeaderFontBold Boolean @default(true)
  tableCellPaddingPt Int    @default(4)
  tableAlignment    String  @default("left")

  // Pagination
  pageBreakBeforeHeadings Boolean @default(true)
  widowOrphanControl  Boolean @default(true)
  firstPageNumber   Int      @default(1)
  restartOnEachSection Boolean @default(false)
  useHybridPageNumbering Boolean @default(false)
  frontMatterThreshold Int?  @default(4)
  frontMatterFormat  String?  @default("lowerRoman")

  createdById      Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdBy        User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  smartTemplates   SmartTemplate[]
  documents        Document[]     @relation("DocStyleProfile")

  @@index([isActive])
  @@index([isDefault])
}

model SmartTemplate {
  id                 Int      @id @default(autoincrement())
  templateName       String
  templateCode       String   @unique
  description        String?  @db.Text
  isActive           Boolean  @default(true)
  documentTypeId     Int
  createdById        Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Style profile linkage (centralized header/footer/formatting)
  styleProfileId     Int?

  // Auto-populated field config
  includeRevisionInDoc  Boolean @default(true)
  includeFileCodeInDoc  Boolean @default(true)
  includePreparedBy     Boolean @default(true)
  includeDates          Boolean @default(true)

  // Relations
  documentType     DocumentType        @relation("DocTypeSmartTemplates", fields: [documentTypeId], references: [id], onDelete: Restrict)
  createdBy        User?               @relation("SmartTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  styleProfile     SmartDocumentStyleProfile? @relation(fields: [styleProfileId], references: [id], onDelete: SetNull)
  versions         SmartTemplateVersion[]
  defaultForDocTypes DocumentType[]    @relation("DocTypeDefaultSmartTemplate")

  @@index([documentTypeId])
  @@index([isActive])
  @@index([templateCode])
}

model SmartTemplateVersion {
  id                 Int      @id @default(autoincrement())
  smartTemplateId    Int
  versionNo          String   // e.g., "1.0", "1.1", "2.0"
  versionLabel       String?  // Optional friendly name

  // Source DOCX template file
  templateFilePath   String?
  templateFileName   String?
  templateFileSize   Int? // bytes
  templateFileHash   String? // integrity check
  templateUploadedAt DateTime?

  // Extracted placeholders (snapshot at version time)
  placeholdersJson   Json? // List of {{placeholders}} detected in DOCX

  // Formatting snapshot (immutable once docs published using this version)
  formattingSnapshot Json? // Copy of styleProfile at publish time

  changeNotes        String?  @db.Text
  isCurrent          Boolean  @default(false)
  isLocked           Boolean  @default(false) // Locked once published docs reference it
  publishedById      Int?
  publishedAt        DateTime?
  createdById        Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  smartTemplate      SmartTemplate        @relation(fields: [smartTemplateId], references: [id], onDelete: Cascade)
  createdBy          User?                @relation("SmartTemplateVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  publishedBy        User?                @relation("SmartTemplateVersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  formFields         SmartFormField[]
  fieldMappings      SmartFieldMapping[]
  sections           SmartTemplateSection[]
  documentVersions   DocumentVersion[]
  smartDocumentContents SmartDocumentContent[]

  @@unique([smartTemplateId, versionNo])
  @@index([smartTemplateId])
  @@index([isCurrent])
  @@index([isLocked])
}

model SmartTemplateSection {
  id                    Int      @id @default(autoincrement())
  smartTemplateVersionId Int
  sectionKey            String   // Machine key, e.g. "purpose", "scope", "procedure"
  sectionName           String   // Display name
  sectionDescription    String?  @db.Text
  sortOrder             Int      @default(0)
  isRequired            Boolean  @default(true)
  isCollapsible         Boolean  @default(true)
  isSystemSection       Boolean  @default(false) // Purpose/Scope/Responsibility etc. may be standard
  sectionHelpText       String?  @db.Text
  parentSectionId       Int?
  layoutConfig          Json?    // Column layout, section styling

  createdById           Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  smartTemplateVersion  SmartTemplateVersion @relation(fields: [smartTemplateVersionId], references: [id], onDelete: Cascade)
  parentSection         SmartTemplateSection? @relation("SectionHierarchy", fields: [parentSectionId], references: [id], onDelete: SetNull)
  childSections         SmartTemplateSection[] @relation("SectionHierarchy")
  fields                SmartFormField[]

  @@index([smartTemplateVersionId])
  @@index([parentSectionId])
  @@index([sortOrder])
  @@unique([smartTemplateVersionId, sectionKey])
}

model SmartFormField {
  id                       Int      @id @default(autoincrement())
  smartTemplateVersionId   Int
  smartTemplateSectionId   Int?
  fieldKey                 String   // Machine key, e.g. "purpose_text", "review_date"
  fieldLabel               String   // Display label
  fieldHelpText            String?  @db.Text
  placeholderHint          String?  // Input placeholder
  inputType                SmartFieldInputType @default(TEXT)

  // Field configuration (dynamic depending on inputType)
  optionsJson              Json?    // For DROPDOWN: { options: [{value, label}], allowMultiple? }
  validationRulesJson      Json?    // { required, minLength, maxLength, regex, min, max, custom? }
  defaultValueJson         Json?    // Default value based on type
  tableSchemaJson          Json?    // For TABLE type: { columns: [{key, label, type, width, required}] }
  repeaterSchemaJson       Json?    // For REPEATER type: { rowFields: [...], minOccurrences, maxOccurrences }
  imageConfigJson          Json?    // For IMAGE: { maxSizeKb, formats:[], widthLimit, heightLimit }
  attachmentConfigJson     Json?    // For ATTACHMENT: { maxSizeKb, formats:[] }
  systemFieldConfigJson    Json?    // For SYSTEM_GENERATED: { sourceType: "REFERENCE_CODE"|"REVISION"|"USER"|"DATE"|..., autoPopulate: true }
  visibilityRulesJson      Json?    // Conditional field visibility: { enabled, match: "ALL"|"ANY", rules: [{ fieldKey, operator: "equals"|"notEquals"|"contains"|"isEmpty"|"isNotEmpty", value }] }

  // Permissions
  isMandatory              Boolean  @default(false)
  isEditableAuthor         Boolean  @default(true)
  isEditableReviewer       Boolean  @default(false)
  isVisibleInForm          Boolean  @default(true)
  isVisibleInPreview       Boolean  @default(true)
  isSearchable             Boolean  @default(false)
  isSupportingField        Boolean  @default(false)

  sortOrder                Int      @default(0)
  createdById              Int?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  smartTemplateVersion     SmartTemplateVersion @relation(fields: [smartTemplateVersionId], references: [id], onDelete: Cascade)
  smartTemplateSection     SmartTemplateSection? @relation(fields: [smartTemplateSectionId], references: [id], onDelete: SetNull)
  fieldMapping             SmartFieldMapping?

  @@unique([smartTemplateVersionId, fieldKey])
  @@index([smartTemplateVersionId])
  @@index([smartTemplateSectionId])
  @@index([sortOrder])
  @@index([inputType])
}

model SmartFieldMapping {
  id                       Int      @id @default(autoincrement())
  smartTemplateVersionId   Int
  smartFormFieldId         Int      @unique

  // Which {{placeholder}} in DOCX this field maps to
  placeholderName          String   // e.g., "{{purpose}}" — the exact string
  placeholderType          SmartPlaceholderType @default(SIMPLE_VALUE)

  // Advanced mapping options
  outputFormatJson         Json?    // Formatting: { dateFormat, numberFormat, textTransform, tableCellRange, imageSize?, font? }
  targetSectionName        String?  // For section-based rendering
  repeatParentTag          String?  // For table rows / repeated sections: parent tag to clone

  sortOrder                Int      @default(0)
  createdById              Int?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  smartTemplateVersion     SmartTemplateVersion @relation(fields: [smartTemplateVersionId], references: [id], onDelete: Cascade)
  smartFormField           SmartFormField       @relation(fields: [smartFormFieldId], references: [id], onDelete: Cascade)

  @@unique([smartTemplateVersionId, placeholderName])
  @@index([smartTemplateVersionId])
  @@index([smartFormFieldId])
}

model SmartDocumentContent {
  id                  Int      @id @default(autoincrement())
  documentId          Int
  documentVersionId   Int?     // Links to DocumentVersion for additive integration

  // CRITICAL: Immutable link to the EXACT template version used
  smartTemplateVersionId Int

  // Form field values — DYNAMIC keys reference SmartFormField.fieldKey
  fieldValuesJson     Json?    // { [fieldKey]: value | richText | {rows:[...]} | {files:[...]} }

  // Snapshots for rendering (immutable once revision is locked)
  autoFieldSnapshotJson Json?  // Reference Code, file code, dates, users at save time
  contentChecksum     String?  // Hash for change detection / audit

  // Audit trail snapshots — drafter baseline, reviewer edits, approver minor tweaks
  fieldAuditTrailJson Json?    // [ { action: 'REVIEWER_DIRECT_EDIT'|'APPROVER_MINOR_TWEAK'|'DRAFTER_BASELINE', userId, timestamp, snapshot: {[fieldKey]: value} } ]
                                 // OR legacy object: { drafterSnapshot: {...}, reviewerSnapshot: {...} }

  // Tracking
  createdById         Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  documentVersion     DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  document            Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  smartTemplateVersion SmartTemplateVersion @relation(fields: [smartTemplateVersionId], references: [id], onDelete: Restrict)
  createdBy           User?            @relation("SmartDocContentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([documentVersionId])
  @@index([documentId])
  @@index([documentVersionId])
  @@index([smartTemplateVersionId])
}

// Per-field change history for Smart Documents
model SmartDocumentFieldChange {
  id                    Int      @id @default(autoincrement())
  documentId            Int
  documentVersionId     Int?
  smartFormFieldKey     String
  changedById           Int?
  changedAt             DateTime @default(now())
  oldValueSnapshot      Json?    // Value before change (or null if new)
  newValueSnapshot      Json?    // Value after change
  changeReason          String?  @db.Text // Optional note / review comment

  // Context
  workflowAction        String?  // "DRAFT_EDIT" | "REVIEWER_SUGGESTION" | "REVIEWER_DIRECT_EDIT" | "AUTHOR_REVISION" | etc.
  sourceCommentId       Int?     // Optional link to DocumentComment

  changedBy             User?    @relation("SmartDocFieldChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  document              Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersionRef    DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([documentVersionId])
  @@index([smartFormFieldKey])
  @@index([changedById])
  @@index([changedAt])
}
