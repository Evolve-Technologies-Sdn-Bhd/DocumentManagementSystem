                "startedAt": { "type": ["string", "null"], "format": "date-time" },
                "endedAt": { "type": ["string", "null"], "format": "date-time" },
                "isActive": { "type": "boolean" }
              }
            }
          }
        }
      },
      "ExternalReference": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "system": { "$ref": "#/components/schemas/System" },
          "entityType": { "$ref": "#/components/schemas/EntityType" },
          "entityId": { "type": "integer" },
          "externalType": { "type": "string" },
          "externalId": { "type": "string" },
          "externalUrl": { "type": ["string", "null"] },
          "metadata": { "type": ["object", "null"], "additionalProperties": true },
          "createdById": { "type": ["integer", "null"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "IntegrationEvent": {
        "type": "object",
        "description": "Outbox event. The same payload is delivered to webhook subscribers.",
        "properties": {
          "id": { "type": "string" },
          "type": { "$ref": "#/components/schemas/EventType" },
          "system": { "type": ["string", "null"] },
