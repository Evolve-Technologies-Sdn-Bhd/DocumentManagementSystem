# ==========================================================================
# DMS Docker Deployment — Environment Configuration
# Copy this file to `.env` at the project root and fill in the values
# before running:
#   bash ./deploy/docker/first-run.sh
# or:
#   docker compose up -d --build
# ==========================================================================

# --------------------------------------------------------------------------
# 1. MySQL Database
# --------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change_me_strong_root_password
MYSQL_DATABASE=dms_prod
MYSQL_USER=dms_user
MYSQL_PASSWORD=change_me_strong_db_password

# --------------------------------------------------------------------------
# 2. Backend Security
# --------------------------------------------------------------------------
# Use long random strings (min 32 chars). Generate with: openssl rand -hex 32
JWT_SECRET=change_me_with_a_long_random_string_please_change_this
ENCRYPTION_KEY=change_me_with_a_long_random_value_for_file_encryption

# --------------------------------------------------------------------------
# 3. Public URLs & CORS
# --------------------------------------------------------------------------
# The URL end-users actually type in the browser (protocol + host only).
# Must match the hostnames you put in DMS_PUBLIC_URLS (below).
# If behind a reverse proxy with a custom domain, put that domain here.
# Multiple origins (comma-separated): https://dms.a.com,https://dms.b.com
FRONTEND_URL=https://dms.example.com
CORS_ORIGIN=https://dms.example.com

# --------------------------------------------------------------------------
# 4. HTTPS / TLS (Caddy reverse proxy)
# --------------------------------------------------------------------------
# Choose a TLS mode:
#
#   auto      ← Caddy will fetch real certificates from Let's Encrypt / ZeroSSL
#               REQUIRED: hostnames must be real public domains, ports 80 & 443
#               reachable from the Internet, and ACME_EMAIL must be a real inbox
#               (Let's Encrypt sends expiry & revocation notices there).
#
#   internal  ← Caddy self-signs certs from its own internal CA. No Internet
#               needed at all. Users MUST import the Caddy internal root CA
#               (lives in the `caddy_data` Docker volume). For intranet
#               evaluations only. Use TLS_MODE=manual for real on-prem deploy.
#
#   manual    ← You provide your own PEM server cert + key (e.g. signed by
#               on-prem Active Directory CA, or the output of
#               `bash ./deploy/docker/generate-onprem-pki.sh`). Set the two
#               TLS_CERT_FILE / TLS_KEY_FILE paths below.
#
TLS_MODE=auto

# Comma-separated list of hostnames (can include scheme or not, it's stripped).
# These become the SANs on the TLS certificate and the Caddy site-block bindings.
# For TLS_MODE=auto these MUST be public FQDNs with DNS pointing to this server.
DMS_PUBLIC_URLS=dms.example.com

# Required for TLS_MODE=auto  (registered inbox — LE notifications sent here)
ACME_EMAIL=admin@example.com

# Required for TLS_MODE=manual (paths are INSIDE the caddy container).
# The container mounts ./deploy/docker/caddy/tls (host) as /etc/caddy/tls (ro).
# Copy your PEM cert+key into that folder, then uncomment + fill below.
# Also run bash ./deploy/docker/generate-onprem-pki.sh to auto-generate a
# trusted on-prem Root CA + Server cert with SANs covering DMS_PUBLIC_URLS.
#TLS_CERT_FILE=/etc/caddy/tls/server-cert.pem
#TLS_KEY_FILE=/etc/caddy/tls/server-key.pem

# --------------------------------------------------------------------------
# 5. Database seed (first run only)
# --------------------------------------------------------------------------
# Set to "true" on the VERY FIRST start to create the default admin account,
# roles, and master data. After the first successful start, set back to "false"
# (or leave it — the seed script is idempotent for most rows).
# NOTE: If you are importing an existing aaPanel dump via import-dump.sh you
#       MUST keep this as "false" (it will overwrite nothing either way, but
#       you want to avoid accidentally seeding twice).
RUN_SEED=true

# --------------------------------------------------------------------------
# 6. AI Integration (optional — leave AI_ENABLED=false if not needed)
# --------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=openai
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=2048
AI_DEFAULT_LANGUAGE=en

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --------------------------------------------------------------------------
# 7. Email / SMTP (optional — for notifications, password reset, 2FA emails)
# --------------------------------------------------------------------------
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="DMS System <noreply@example.com>"
